{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Kernel.php"
        ]
    },
    "testFrameworkOptions": "--exclude-group=concurrency",
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true
    }
}
